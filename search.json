---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- for p in site.posts -%}
  {
    "type": "Post",
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "date": {{ p.date | date: "%b %d, %Y" | jsonify }},
    "tags": {{ p.tags | join: " " | jsonify }},
    "desc": {{ p.description | default: p.excerpt | strip_html | normalize_whitespace | jsonify }},
    "text": {{ p.content | strip_html | normalize_whitespace | truncate: 30000, "" | jsonify }}
  },
{%- endfor -%}
{%- for pg in site.pages -%}
  {%- if pg.title and pg.sitemap != false and pg.url != "/search/" -%}
  {%- unless pg.url contains ".xml" or pg.url contains ".txt" or pg.url contains ".json" -%}
  {
    "type": "Page",
    "title": {{ pg.title | jsonify }},
    "url": {{ pg.url | relative_url | jsonify }},
    "date": "",
    "tags": "",
    "desc": {{ pg.description | default: "" | strip_html | normalize_whitespace | jsonify }},
    "text": ""
  },
  {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- for pr in site.data.projects -%}
  {
    "type": "Project",
    "title": {{ pr.name | append: " — " | append: pr.tagline | jsonify }},
    {%- capture pr_anchor %}/projects/#{{ pr.name | slugify }}{% endcapture %}
    "url": {{ pr.post | default: pr_anchor | relative_url | jsonify }},
    "date": "",
    "tags": {{ pr.tags | join: " " | append: " " | append: pr.category | jsonify }},
    "desc": {{ pr.description | normalize_whitespace | jsonify }},
    "text": ""
  },
{%- endfor -%}
{%- for pa in site.data.papers -%}
  {
    "type": "Paper",
    "title": {{ pa.title | jsonify }},
    {%- capture pa_anchor %}/research/#paper-{{ pa.title | slugify }}{% endcapture %}
    "url": {{ pa.tldr_post | default: pa_anchor | relative_url | jsonify }},
    "date": {{ pa.year | append: "" | jsonify }},
    "tags": {{ pa.authors | append: " " | append: pa.topic | jsonify }},
    "desc": {{ pa.tldr | normalize_whitespace | jsonify }},
    "text": ""
  },
{%- endfor -%}
{%- for tk in site.data.talks -%}
  {
    "type": "Talk",
    "title": {{ tk.title | jsonify }},
    "url": {{ tk.title | slugify | prepend: "/talks/#talk-" | relative_url | jsonify }},
    "date": "",
    "tags": {{ tk.speaker | append: " " | append: tk.event | append: " " | append: tk.topic | jsonify }},
    "desc": {{ tk.speaker | append: " · " | append: tk.event | append: " — " | append: tk.take | normalize_whitespace | jsonify }},
    "text": ""
  },
{%- endfor -%}
{%- for group in site.data.achievements -%}
{%- for ac in group.items -%}
  {
    "type": "Achievement",
    "title": {{ ac.title | jsonify }},
    "url": {{ ac.title | slugify | prepend: "/achievements/#ach-" | relative_url | jsonify }},
    "date": {{ ac.year | default: "" | append: "" | jsonify }},
    "tags": {{ group.section | append: " " | append: ac.year | jsonify }},
    "desc": {{ ac.detail | default: "" | normalize_whitespace | jsonify }},
    "text": ""
  },
{%- endfor -%}
{%- endfor -%}
{%- for job in site.data.experience -%}
{%- for role in job.roles -%}
  {%- capture role_key %}{{ job.company }} {{ role.title }}{% endcapture %}
  {
    "type": "Role",
    "title": {{ role.title | append: " — " | append: job.company | jsonify }},
    "url": {{ role_key | replace: "&", " and " | slugify | prepend: "/experience/#role-" | relative_url | jsonify }},
    "date": {{ role.period | default: job.span | jsonify }},
    "tags": {{ job.tags | join: " " | append: " " | append: job.company | append: " " | append: job.location | jsonify }},
    "desc": {{ job.company | append: " · " | append: job.location | append: " · " | append: role.period | jsonify }},
    "text": {{ role.highlights | join: " " | normalize_whitespace | jsonify }}
  },
{%- endfor -%}
{%- endfor -%}
{%- for ev in site.data.events -%}
  {%- assign ev_anchor = ev.name | slugify | prepend: "/events/#" -%}
  {
    "type": "Event",
    "title": {{ ev.name | jsonify }},
    "url": {{ ev.recap | default: ev_anchor | relative_url | jsonify }},
    "date": {{ ev.date | date: "%b %d, %Y" | jsonify }},
    "tags": {{ ev.role | jsonify }},
    "desc": {{ ev.location | jsonify }},
    "text": ""
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
