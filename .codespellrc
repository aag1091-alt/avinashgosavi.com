# Spell check for the CI "Spelling" step (and for anyone running `codespell` locally).
# Words below are real names/abbreviations codespell mistakes for typos:
#   rouge — the Rouge syntax highlighter; pres — <pre> elements in scripts/check_a11y.py
# ignore-regex skips deliberate typos used as search demos: search links (?q=…)
# and the `(try "…")` hints in _data/changelog.yml.
[codespell]
skip = ./.git,./_site,./vendor,./node_modules,./.jekyll-cache,./assets/fonts,./assets/images,./assets/og,./assets/icons,*.png,*.jpg,*.jpeg,*.webp,*.woff2,*.ico,*.pdf,Gemfile.lock,./_notes,*/__pycache__
ignore-words-list = rouge,pres
ignore-regex = \?q=[^\s&)\]]+|\(try "[^)]*\)
